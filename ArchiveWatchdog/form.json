{
  "elements": [
    {
      "type": "Label",
      "caption": "v0.3.07 (Build 10): bestätigte vollständige Bereinigung inklusive markierter Datenlücken; Vorschau/Tabelle und sichere Automatik bleiben erhalten."
    },
    {
      "type": "CheckBox",
      "name": "Enabled",
      "caption": "Regelmäßig prüfen"
    },
    {
      "type": "CheckBox",
      "name": "AutoDelete",
      "caption": "Automatische Löschung bei regelmäßiger Prüfung (standardmäßig AUS)"
    },
    {
      "type": "NumberSpinner",
      "name": "IntervalMinutes",
      "caption": "Prüfintervall (Minuten)",
      "minimum": 1
    },
    {
      "type": "NumberSpinner",
      "name": "LookbackHours",
      "caption": "Normaler Prüfzeitraum (Stunden)",
      "minimum": 1
    },
    {
      "type": "NumberSpinner",
      "name": "MinAgeMinutes",
      "caption": "Neueste Daten auslassen (Minuten)",
      "minimum": 1
    },
    {
      "type": "NumberSpinner",
      "name": "TrainingDays",
      "caption": "Lernzeitraum (Tage)",
      "minimum": 1,
      "maximum": 365
    },
    {
      "type": "NumberSpinner",
      "name": "SafetyFactor",
      "caption": "Großzügigkeitsfaktor (gelernter 95%-Sprung × Faktor, mindestens Min. Sprung)",
      "minimum": 1,
      "maximum": 20,
      "digits": 2
    },
    {
      "type": "NumberSpinner",
      "name": "MaxErrorSeries",
      "caption": "Maximale Länge kurzer Fehlerfolgen (Messpunkte)",
      "minimum": 1,
      "maximum": 20
    },
    {
      "type": "ValidationTextBox",
      "name": "ArchiveStartDate",
      "caption": "Archiv ab Datum prüfen/löschen (JJJJ-MM-TT)"
    },
    {
      "type": "CheckBox",
      "name": "AdvancedSettings",
      "caption": "Erweiterte Einstellungen für Variablen anzeigen (danach übernehmen und erneut öffnen)"
    },
    {
      "type": "List",
      "name": "Targets",
      "caption": "Überwachte Archivvariablen",
      "rowCount": 8,
      "add": true,
      "delete": true,
      "columns": [
        {
          "name": "VariableID",
          "caption": "Variable",
          "width": "200px",
          "add": 0,
          "edit": {
            "type": "SelectVariable"
          }
        },
        {
          "name": "Mode",
          "caption": "Verlauf",
          "width": "150px",
          "add": 0,
          "edit": {
            "type": "Select",
            "options": [
              {
                "caption": "Messwert",
                "value": 0
              },
              {
                "caption": "Zähler aufwärts",
                "value": 1
              },
              {
                "caption": "Zähler abwärts",
                "value": 2
              }
            ]
          }
        },
        {
          "name": "Sensitivity",
          "caption": "Empfindlichkeit",
          "width": "150px",
          "add": 1,
          "edit": {
            "type": "Select",
            "options": [
              {
                "caption": "Empfindlich",
                "value": 0
              },
              {
                "caption": "Normal",
                "value": 1
              },
              {
                "caption": "Großzügig",
                "value": 2
              }
            ]
          }
        },
        {
          "name": "Spike",
          "caption": "Min. Sprung",
          "width": "110px",
          "add": 3,
          "edit": {
            "type": "NumberSpinner",
            "digits": 3
          }
        },
        {
          "name": "NeighborTolerance",
          "caption": "Nachbar-Toleranz",
          "width": "130px",
          "add": 1,
          "edit": {
            "type": "NumberSpinner",
            "digits": 3
          }
        },
        {
          "name": "MaxGapMinutes",
          "caption": "Max. Abstand (min, nur Zähler)",
          "width": "120px",
          "add": 30,
          "edit": {
            "type": "NumberSpinner"
          }
        },
        {
          "name": "UseManual",
          "caption": "Manuelle Grenzen",
          "width": "100px",
          "add": false,
          "edit": {
            "type": "CheckBox"
          }
        },
        {
          "name": "Enabled",
          "caption": "Aktiv",
          "width": "80px",
          "add": true,
          "edit": {
            "type": "CheckBox"
          }
        }
      ]
    },
    {
      "type": "SelectVariable",
      "name": "DiagnosticVariableID",
      "caption": "Diagnose: Variable (z. B. 38701)"
    },
    {
      "type": "ValidationTextBox",
      "name": "DiagnosticDate",
      "caption": "Diagnose: Datum (JJJJ-MM-TT)"
    },
    {
      "type": "ValidationTextBox",
      "name": "ManualDeleteTimestamp",
      "caption": "Manuelle Freigabe: Uhrzeit HH:MM:SS (zum Diagnose-Datum)"
    }
  ],
  "actions": [
    {
      "type": "Button",
      "caption": "Einzeltag-Diagnose (nur prüfen, keine Löschung)",
      "onClick": "echo AWD_DiagnoseDay($id);"
    },
    {
      "type": "Button",
      "caption": "Manuell bestätigten Ausreißer am Diagnose-Tag löschen",
      "confirm": "Den angegebenen auffälligen Rohwert nach erneuter Prüfung UNWIDERRUFLICH löschen und die Variable reaggregieren? Vorher Archiv sichern!",
      "onClick": "echo AWD_DeleteReviewedPoint($id);"
    },
    {
      "type": "Button",
      "caption": "Aus Archiv lernen (nur Statistik)",
      "onClick": "echo AWD_Learn($id);"
    },
    {
      "type": "Button",
      "caption": "Prüfzeitraum prüfen (Vorschau)",
      "onClick": "echo AWD_Scan($id, false, false);"
    },
    {
      "type": "Button",
      "caption": "Gesamtes Archiv ab Startdatum prüfen (Vorschau)",
      "onClick": "echo AWD_Scan($id, false, true);"
    },
    {
      "type": "Button",
      "caption": "Sichere Bereinigung: Prüfzeitraum (große Datenlücken auslassen)",
      "confirm": "WIRKLICH alle erkannten Ausreißer des Prüfzeitraums unwiderruflich aus den Archiven der aktiven Variablen löschen? Archiv vorher sichern!",
      "onClick": "echo AWD_Scan($id, true, false);"
    },
    {
      "type": "Button",
      "caption": "Sichere Bereinigung: Archiv ab Startdatum (große Datenlücken auslassen)",
      "confirm": "ACHTUNG: ALLE erkannten Ausreißer seit dem eingestellten Startdatum aus den Archiven ALLER aktiven Variablen löschen? Vorher vollständige Sicherung anlegen!",
      "onClick": "echo AWD_Scan($id, true, true);"
    },
    {
      "type": "Button",
      "caption": "Vollständige Bereinigung MIT manueller Freigabe – Prüfzeitraum",
      "confirm": "UNWIDERRUFLICH: Auch die wegen großer Zeitlücken markierten Ausreißer aller aktiven Variablen im Prüfzeitraum löschen? Eine lange Datenlücke kann echte Änderungen verbergen. Vorher Vorschau kontrollieren und ARCHIV SICHERN!",
      "onClick": "echo AWD_Scan($id, true, false, true);"
    },
    {
      "type": "Button",
      "caption": "Vollständige Bereinigung MIT manueller Freigabe – Archiv ab Startdatum",
      "confirm": "UNWIDERRUFLICH: Auch ALLE wegen großer Zeitlücken markierten Ausreißer im GESAMTEN Zeitraum ab Archiv-Startdatum für ALLE aktiven Variablen löschen? Fehlklassifikationen sind möglich! Vorher Vorschau kontrollieren und ARCHIV SICHERN!",
      "onClick": "echo AWD_Scan($id, true, true, true);"
    },
    {
      "type": "Label",
      "caption": "Vorschau, Diagnose und Lernen: niemals löschen oder reaggregieren. Sichere Bereinigung überspringt große Datenlücken. Nur die separat bestätigte vollständige Bereinigung darf diese Kandidaten ebenfalls löschen. Reaggregation nach tatsächlicher Löschung einmal je Variable."
    }
  ]
}
